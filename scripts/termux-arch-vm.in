#!@TERMUX_PREFIX@/bin/sh
set -eu
usage() {
    echo 'Usage: termux-arch-vm [--status | --start [--memory SIZE] | --stop]'
    echo 'RAM sizes: 8G, 8192M, or MiB. Saved after successful boot; changes require a stopped VM.'
    echo 'Manage the fixed experimental Arch AVF guest through authorized Shizuku.'
    echo 'Requires staged v2 CI guest images. Writable guest; use termux-arch for first-time SSH setup.'
    echo 'JSON status reports boot readiness; command exit 0 only confirms transport.'
}
operation=status
selected=false
memory=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --status|--start|--stop)
            if "$selected"; then usage >&2; exit 2; fi
            operation=${1#--}; selected=true ;;
        --memory)
            if [ "$#" -lt 2 ] || [ -n "$memory" ] || [ -z "$2" ]; then usage >&2; exit 2; fi
            memory=$2; shift ;;
        --memory=*)
            if [ -n "$memory" ] || [ -z "${1#*=}" ]; then usage >&2; exit 2; fi
            memory=${1#*=} ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done
if [ -n "$memory" ]; then
    if [ "$operation" != start ]; then usage >&2; exit 2; fi
    exec "@TERMUX_PREFIX@/bin/termux-arch" --start --memory "$memory"
fi
exec "@TERMUX_PREFIX@/bin/timeout" --foreground 20 \
    "@TERMUX_PREFIX@/libexec/termux-api" Virtualization --es operation "arch-$operation"
