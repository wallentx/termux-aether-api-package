#!@TERMUX_PREFIX@/bin/python
"""Open the persistent Arch AVF guest using authenticated SSH over vsock."""
import argparse
from contextlib import contextmanager, ExitStack
from decimal import Decimal, InvalidOperation
import base64
import fcntl
import json
import os
import re
from pathlib import Path
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import threading
import uuid

PREFIX = '@TERMUX_PREFIX@'
DEFAULT_CONFIG = {'user': 'root', 'cwd': None, 'memory': None, 'graphics_mode': None,
                  'keep_memory': False, 'tty': None}
CONFIG_TEMPLATE = '''# Default execution account inside Arch; the account must already exist.
user: root
# null starts in the selected guest user's home; otherwise use an absolute guest path.
cwd: null
# null keeps the VM's saved RAM size; examples: 8G, 8192M, 8192 (MiB).
memory: null
# null reuses an existing VM's mode and starts new VMs headless.
# gfxstream enables the GPU on each boot; none explicitly requests headless.
graphics_mode: null
# Retain guest RAM/processes after the last session instead of shutting down.
keep_memory: false
# null chooses automatically: true for a shell, false for a command.
tty: null
'''


def config_path():
    xdg = os.environ.get('XDG_CONFIG_HOME', '')
    base = Path(xdg) if xdg and Path(xdg).is_absolute() else Path.home() / '.config'
    return base / 'termux-arch/config.yml'


def execution_user(value):
    if not isinstance(value, str) or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_.-]{0,255}\$?', value):
        raise ValueError('user must be a guest account name such as root or alarm')
    return value


def unique_mapping(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f'Duplicate config key: {key}')
        result[key] = value
    return result


def load_config():
    path = config_path()
    path.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    # Termux forbids hard links. Serialize creation/read and create exclusively so
    # another launcher cannot read a partial file or overwrite an existing config.
    lock = os.open(path.parent / '.config.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(lock, 'w') as lock_stream:
        fcntl.flock(lock_stream, fcntl.LOCK_EX)
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        except FileExistsError:
            pass
        else:
            with os.fdopen(fd, 'w') as stream:
                stream.write(CONFIG_TEMPLATE)
                stream.flush()
                os.fsync(stream.fileno())
        if not path.is_file():
            raise ValueError(f'Config must be a regular YAML file: {path}')
        with path.open('rb') as stream:
            raw = stream.read(65537)
    if len(raw) > 65536:
        raise ValueError(f'Config exceeds 64 KiB: {path}')
    yq = shutil.which('yq')
    if yq is None:
        raise RuntimeError('Install yq (version 4) to read the termux-arch YAML config')
    parsed = subprocess.run([yq, '-p=yaml', '-o=json', '-I=0', '.'], input=raw,
                            capture_output=True, timeout=5)
    if parsed.returncode:
        raise ValueError(f'Invalid YAML config {path}: {parsed.stderr.decode(errors="replace").strip()}')
    try:
        values = json.loads(parsed.stdout, object_pairs_hook=unique_mapping)
    except (ValueError, UnicodeError) as error:
        raise ValueError(f'Invalid YAML config {path}: {error}') from error
    if values is None:
        values = {}
    if not isinstance(values, dict):
        raise ValueError(f'Config must contain a mapping of settings: {path}')
    unknown = values.keys() - DEFAULT_CONFIG.keys()
    if unknown:
        raise ValueError('Unknown config settings: ' + ', '.join(sorted(unknown)))
    result = dict(DEFAULT_CONFIG, **values)
    execution_user(result['user'])
    cwd = result['cwd']
    if cwd is not None and (not isinstance(cwd, str) or not cwd.startswith('/') or '\0' in cwd):
        raise ValueError('cwd must be null (guest home) or an absolute guest path')
    if type(result['keep_memory']) is not bool:
        raise ValueError('keep_memory must be true or false')
    if result['tty'] is not None and type(result['tty']) is not bool:
        raise ValueError('tty must be null, true or false')
    if result['graphics_mode'] not in (None, 'none', 'gfxstream'):
        raise ValueError('graphics_mode must be null, none or gfxstream')
    memory = result['memory']
    if memory is not None:
        if type(memory) not in (str, int):
            raise ValueError('memory must be null, a size such as 8G, or an integer number of MiB')
        try:
            memory_mib(str(memory))
        except argparse.ArgumentTypeError as error:
            raise ValueError(f'Invalid config memory: {error}') from error
    return result


def memory_mib(value):
    match = re.fullmatch(r'([0-9]+(?:\.[0-9]+)?)(gib|mib|g|m)?', value, re.I) if len(value) <= 32 else None
    if not match:
        raise argparse.ArgumentTypeError('Use a positive memory size such as 8G, 1.5G or 8192M')
    try:
        size = Decimal(match[1]) * (1024 if (match[2] or '').lower().startswith('g') else 1)
        if size != size.to_integral_value() or not 1 <= size <= 2147483647:
            raise ValueError()
        return int(size)
    except (InvalidOperation, ValueError):
        raise argparse.ArgumentTypeError('Memory must be a positive whole number of MiB')


def public_key(value):
    if not isinstance(value, str):
        raise ValueError("Expected an Ed25519 public key")
    parts = value.split()
    if len(parts) != 2 or parts[0] != 'ssh-ed25519':
        raise ValueError('Expected an Ed25519 public key')
    raw = base64.b64decode(parts[1], validate=True)
    if len(raw) != 51 or raw[:19] != b'\0\0\0\x0bssh-ed25519\0\0\0\x20':
        raise ValueError('Invalid Ed25519 public key')
    return ' '.join(parts)


def credentials(directory):
    directory.mkdir(parents=True, mode=0o700, exist_ok=True)
    info = directory.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError(f'Credential directory must be owned by you and mode 700: {directory}')
    lock = os.open(directory / 'setup.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(lock, 'w') as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        identity = directory / 'id_ed25519'
        if not identity.exists():
            # A unique temporary path prevents a partial key from becoming active.
            with tempfile.TemporaryDirectory(prefix='key-', dir=directory) as work:
                temporary = Path(work) / 'identity'
                subprocess.run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-C', 'termux-arch-v2',
                                '-f', str(temporary)], check=True, timeout=15)
                os.replace(temporary.with_suffix('.pub'), identity.with_suffix('.pub'))
                os.replace(temporary, identity)
        info = identity.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError('SSH private key must be a private regular file owned by you')
        # Derive the public key from the private key rather than trusting a stale .pub.
        value = subprocess.check_output(['ssh-keygen', '-y', '-f', str(identity)], text=True, timeout=10)
        key = public_key(' '.join(value.split()[:2]))
        return identity, key


def api(operation, key=None, memory=None, *, token=None, keep_memory=False, disk_bytes=None,
        shared_path=None, graphics_mode=None):
    command = [f'{PREFIX}/bin/timeout', '--foreground', '20', f'{PREFIX}/libexec/termux-api',
               'Virtualization', '--es', 'operation', 'arch-' + operation]
    if key is not None:
        command += ['--es', 'ssh_public_key', key]
    if memory is not None:
        command += ['--es', 'memory_mib', str(memory)]
    if token is not None:
        command += ['--es', 'session_token', token, '--ez', 'keep_memory', str(keep_memory).lower()]
    if disk_bytes is not None:
        command += ['--es', 'disk_bytes', str(disk_bytes)]
    if shared_path is not None:
        command += ['--es', 'shared_path', shared_path]
    if graphics_mode is not None:
        command += ['--es', 'graphics_mode', graphics_mode]
    result = subprocess.run(command, capture_output=True, text=True, timeout=22)
    if result.returncode:
        raise RuntimeError(f'VM API transport failed ({result.returncode}): {result.stderr.strip()}')
    return json.loads(result.stdout)


def check_api_access(report, *, allow_boot_error=False):
    if not isinstance(report, dict):
        raise RuntimeError('VM API returned an invalid response')
    status = report.get('status')
    reason = report.get('reason')
    # A full status report can retain a failed boot; a new start may retry it.
    previous_boot_error = (allow_boot_error and report.get('vm_name') == 'termux-arch-v2'
                           and report.get('running') is False)
    if (status in ('denied', 'unavailable') or (status == 'unsupported' and reason)
            or (status == 'error' and not previous_boot_error)):
        if reason == 'memory_change_requires_stop':
            raise RuntimeError('RAM change requires a clean stop: run termux-arch-vm --stop, then retry')
        if reason == 'graphics_change_requires_stop':
            raise RuntimeError('Graphics change requires a clean stop: run termux-arch-vm --stop, then retry')
        detail = reason or report.get('error') or ('Shizuku access is not authorized' if status == 'denied'
                                                  else 'check Termux:API and Shizuku access')
        raise RuntimeError(f'VM API {status}: {detail}')


@contextmanager
def startup_lock(directory):
    # All supported launchers share this lock, including launches with no explicit
    # graphics setting. Raw API callers must coordinate separately.
    fd = os.open(directory / 'startup.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        yield


@contextmanager
def vm_session(keep_memory=False):
    token = uuid.uuid4().hex
    deadline = time.monotonic() + 30
    while True:
        report = api('session-acquire', token=token, keep_memory=keep_memory)
        check_api_access(report)
        if report.get('session_lifecycle') is not True:
            raise RuntimeError('Update Termux:API for automatic Arch session cleanup')
        state = report.get('session_status')
        if state == 'acquired':
            break
        if state != 'busy' or time.monotonic() >= deadline:
            raise RuntimeError(f'Cannot acquire Arch session: {state or report.get("reason", "unknown error")}')
        time.sleep(.25)

    done = threading.Event()

    def heartbeat():
        while not done.wait(15):
            try:
                response = api('session-renew', token=token)
                if response.get('session_status') != 'renewed':
                    raise RuntimeError('session lease expired')
            except Exception as error:
                if not done.is_set():
                    print(f'termux-arch: session renewal failed: {error}', file=sys.stderr)
                # A live SSH connection also prevents idle shutdown.

    thread = threading.Thread(target=heartbeat, name='arch-session-lease', daemon=True)
    thread.start()
    try:
        yield
    finally:
        done.set()
        thread.join(timeout=1)
        try:
            report = api('session-release', token=token)
            if report.get('session_status') != 'released':
                raise RuntimeError(report.get('reason', 'session release was not acknowledged'))
            closing_connection_deadline = time.monotonic() + 2
            deadline = time.monotonic() + 18
            while report.get('running') and not report.get('suspended'):
                if report.get('active_sessions', 0):
                    break  # Another tracked session owns the guest.
                if report.get('ssh_connections', 0) and time.monotonic() >= closing_connection_deadline:
                    break  # A raw SSH connection still owns the guest.
                if report.get('idle_error') or report.get('reason'):
                    raise RuntimeError(report.get('idle_error') or report['reason'])
                if time.monotonic() >= deadline:
                    raise TimeoutError('idle transition did not finish; inspect termux-arch-vm --status')
                time.sleep(.25)
                report = api('status')
        except Exception as error:
            # Cleanup errors must not replace the guest command's exit status.
            print(f'termux-arch: automatic idle cleanup: {error}', file=sys.stderr)


def run_ssh(invocation):
    previous = {}

    def interrupted(number, _frame):
        raise SystemExit(128 + number)

    for number in (signal.SIGTERM, signal.SIGHUP):
        previous[number] = signal.signal(number, interrupted)
    child = None
    try:
        child = subprocess.Popen(invocation)
        try:
            status = child.wait()
            return status if status >= 0 else 128 - status
        except BaseException:
            if child.poll() is None:
                child.terminate()
                try:
                    child.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait()
            raise
    finally:
        for number, handler in previous.items():
            signal.signal(number, handler)


def check_preferences(memory=None, graphics_mode=None):
    if memory is None and graphics_mode is None:
        return
    current = api('status')
    check_api_access(current, allow_boot_error=True)
    if memory is not None:
        if current.get('memory_configurable') is not True:
            raise RuntimeError('The API does not report configurable RAM; update Termux:API or check Shizuku access')
        if current.get('running') and current.get('memory_mib') != memory:
            raise RuntimeError('RAM change requires a clean stop: run termux-arch-vm --stop, then retry')
    if graphics_mode is not None:
        if current.get('graphics_configurable') is not True:
            raise RuntimeError('The API does not report configurable graphics; update Termux:API')
        if type(current.get('running')) is not bool:
            raise RuntimeError('API did not report whether the VM is running; refusing to change graphics')
        if current['running']:
            if current.get('graphics_mode') != graphics_mode:
                raise RuntimeError('Graphics change requires a clean stop: run termux-arch-vm --stop, then retry')
        elif graphics_mode == 'gfxstream' and current.get('graphics_kernel_present') is not True:
            raise RuntimeError('The Gfxstream kernel is missing; install Image-gfxstream before enabling GPU graphics')


def ensure_ready(key, memory=None, graphics_mode=None, *, prechecked=False):
    if not prechecked:
        check_preferences(memory, graphics_mode)
    options = {} if graphics_mode is None else {'graphics_mode': graphics_mode}
    report = api('start', key, memory, **options) if memory is not None else api('start', key, **options)
    check_api_access(report)
    deadline = time.monotonic() + 60
    while report.get('status') in ('starting', 'booting'):
        if time.monotonic() >= deadline:
            raise TimeoutError('Arch did not become ready in 60 seconds; inspect termux-arch-vm --status')
        time.sleep(0.25)
        report = api('status')
        check_api_access(report)
    if report.get('status') != 'ready' or not report.get('running'):
        if report.get('reason') == 'memory_change_requires_stop':
            raise RuntimeError('RAM change requires a clean stop: run termux-arch-vm --stop, then retry')
        raise RuntimeError(f"Arch is not ready: {report.get('reason') or report.get('status')}")
    if memory is not None and report.get('memory_mib') != memory:
        raise RuntimeError('API did not apply requested RAM; refusing to execute the guest command')
    if graphics_mode is not None and report.get('graphics_mode') != graphics_mode:
        raise RuntimeError('API did not apply requested graphics mode; refusing to execute the guest command')
    if report.get('memory_preference_error'):
        print('termux-arch: warning: ' + report['memory_preference_error'], file=sys.stderr)
    if report.get('vm_name') != 'termux-arch-v2' or not isinstance(report.get('ssh_port'), int):
        raise RuntimeError('API does not provide the expected Arch SSH endpoint')
    if not 1 <= report['ssh_port'] <= 65535:
        raise RuntimeError('Invalid SSH endpoint port')
    public_key(report.get('ssh_host_key', ''))
    return report


@contextmanager
def ready_vm(directory, key, *, keep_memory=False, memory=None, graphics_mode=None, managed=True):
    """Start/reuse a compatible VM, retaining an optional lease for the caller."""
    with ExitStack() as session:
        with startup_lock(directory):
            # Acquiring a lease adopts the VM's idle policy. Reject incompatible
            # existing VMs before acquisition so failures leave them untouched.
            check_preferences(memory, graphics_mode)
            if managed:
                session.enter_context(vm_session(keep_memory))
            report = ensure_ready(key, memory, graphics_mode, prechecked=True)
        yield report


def pin_host(directory, key):
    fd = os.open(directory / 'setup.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return _pin_host(directory, key)


def _pin_host(directory, key):
    expected = f'termux-arch-v2 {public_key(key)}\n'
    path = directory / 'known_hosts'
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        if path.is_symlink() or path.read_text() != expected:
            raise RuntimeError('Arch SSH host key changed; inspect the guest before replacing known_hosts')
    else:
        with os.fdopen(fd, 'w') as stream:
            stream.write(expected)
    return path


def remote_command(cwd, command, user='root'):
    execution_user(user)
    if cwd is not None and (not isinstance(cwd, str) or not cwd.startswith('/') or '\0' in cwd):
        raise ValueError('--cwd must be an absolute guest path')
    if any('\0' in arg for arg in command):
        raise ValueError('Command arguments cannot contain NUL')
    argv = command or ['/bin/bash', '-l']
    if user == 'root':
        directory = '"$HOME"' if cwd is None else shlex.quote(cwd)
        return 'cd -- ' + directory + ' && exec ' + shlex.join(argv)
    # Root SSH is bootstrapped by the VM. Drop identity before cd/exec, without
    # enabling SSH access for other accounts or interpreting their command argv.
    script = 'cd -- "$HOME" && exec "$@"' if cwd is None else 'cd -- "$1" && shift && exec "$@"'
    return 'exec ' + shlex.join(['/usr/bin/runuser', '--user', user, '--', '/bin/bash', '-c',
                                script, 'termux-arch', *([] if cwd is None else [cwd]), *argv])


def ssh_command(identity, known, port, cwd, command, tty, user='root'):
    return ['ssh', '-F', '/dev/null', '-i', str(identity), '-p', str(port),
            '-o', 'BatchMode=yes', '-o', 'IdentitiesOnly=yes', '-o', 'IdentityAgent=none',
            '-o', 'StrictHostKeyChecking=yes', '-o', f'UserKnownHostsFile="{known}"',
            '-o', 'GlobalKnownHostsFile=/dev/null', '-o', 'HostKeyAlias=termux-arch-v2',
            '-o', 'ConnectTimeout=5', '-o', 'ServerAliveInterval=15', '-o', 'ServerAliveCountMax=3',
            '-o', 'ClearAllForwardings=yes', '-o', 'EscapeChar=none', '-tt' if tty else '-T',
            'root@127.0.0.1', remote_command(cwd, command, user)]


def parse_options(argv=None):
    parser = argparse.ArgumentParser(description=__doc__,
        epilog=f'Defaults: {config_path()}. Guest paths only; host cwd is not forwarded.')
    parser.add_argument('--user', help='Guest execution user (overrides config)')
    parser.add_argument('--cwd', help='Absolute guest working directory (default: configured path or guest user home)')
    parser.add_argument('--shell', action='store_true', help='Open a login shell in the guest home')
    parser.add_argument('--start', action='store_true', help='Start the VM, wait for readiness and print JSON status')
    parser.add_argument('--memory', type=memory_mib, metavar='SIZE',
                        help='Guest RAM ceiling (8G, 8192M or MiB); saved after successful boot. Changes require a stopped VM.')
    parser.add_argument('--graphics-mode', choices=('none', 'gfxstream'),
                        help='Guest graphics mode (overrides config); changes require a stopped VM')
    lifecycle = parser.add_mutually_exclusive_group()
    lifecycle.add_argument('--keep-memory', action='store_true', default=None,
                        help='Suspend instead of shutting down after the last session; retains guest RAM and processes')
    lifecycle.add_argument('--no-keep-memory', dest='keep_memory', action='store_false',
                           help='Release guest RAM after the last session, overriding config')
    terminal = parser.add_mutually_exclusive_group()
    terminal.add_argument('--tty', action='store_true', default=None, help='Allocate a guest PTY')
    terminal.add_argument('--no-tty', dest='tty', action='store_false', help='Do not allocate a guest PTY')
    parser.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    command = args.command
    if command and command[0] == '--':
        command = command[1:]
    if args.shell and command:
        parser.error('--shell does not accept a command')
    if args.start and args.keep_memory:
        parser.error('--keep-memory requires a shell or command, not --start')
    if args.start and (command or args.shell):
        parser.error('--start does not accept --shell or a guest command')
    try:
        config = load_config()
        for key in ('user', 'cwd', 'keep_memory', 'tty', 'graphics_mode'):
            if getattr(args, key) is None:
                setattr(args, key, config[key])
        if args.memory is None and config['memory'] is not None:
            args.memory = memory_mib(str(config['memory']))
        remote_command(args.cwd, command, args.user)  # Validate before starting the VM.
    except (OSError, ValueError, RuntimeError, argparse.ArgumentTypeError, subprocess.SubprocessError) as error:
        parser.error(str(error))
    args.command = command
    if args.tty is None:
        args.tty = not bool(command)
    if args.start:
        args.keep_memory = False  # Session-only config must not block the start action.
    return args


def main(argv=None):
    args = parse_options(argv)
    for program in ('ssh', 'ssh-keygen'):
        if shutil.which(program) is None:
            raise RuntimeError('Install the openssh package in Termux first')
    directory = Path.home() / '.config/termux/arch-vm'
    identity, key = credentials(directory)
    with ready_vm(directory, key, keep_memory=args.keep_memory, memory=args.memory,
                  graphics_mode=args.graphics_mode, managed=not args.start) as report:
        if args.start:
            print(json.dumps(report, indent=2))
            return 0
        known = pin_host(directory, report['ssh_host_key'])
        invocation = ssh_command(identity, known, report['ssh_port'], args.cwd, args.command, args.tty, args.user)
        # Do not retry a failed SSH command: it may already have changed guest files.
        return run_ssh(invocation)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'termux-arch: {error}', file=sys.stderr)
        sys.exit(1)
