#!@TERMUX_PREFIX@/bin/python
"""Configure Arch storage sharing, sparse disk size or live RAM balloon target."""
import argparse
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import subprocess
import sys

DEFAULT_SHARE = '/storage/emulated/0/Download/AetherShared'


def shared_folder(value):
    if (not value.startswith('/storage/emulated/0/')
            or len(value.encode('utf-8')) > 4096 or any(c in value for c in '\0\r\n')
            or any(part in ('', '.', '..') for part in value.split('/')[1:])):
        raise argparse.ArgumentTypeError('Select an absolute Android shared-storage folder; private home uses SSHFS')
    return value


def load_arch():
    loader = importlib.machinery.SourceFileLoader('arch_session', '@TERMUX_PREFIX@/bin/termux-arch')
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main(argv=None):
    arch = load_arch()
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument('--memory-live', type=arch.memory_mib, metavar='SIZE', help='Desired guest RAM within its launch ceiling')
    mode.add_argument('--grow-disk', type=arch.memory_mib, metavar='SIZE', help='New disk capacity; requires a stopped VM, never shrinks')
    mode.add_argument('--share-enable', nargs='?', const=DEFAULT_SHARE, type=shared_folder, metavar='ANDROID_FOLDER',
                      help='Share this folder at /mnt/android on subsequent boots; default: Download/AetherShared')
    mode.add_argument('--share-disable', action='store_true', help='Disable sharing on subsequent boots; does not delete files')
    args = parser.parse_args(argv)
    if args.share_enable is not None or args.share_disable:
        current = arch.api('status')
        if current.get('shared_storage_supported') is not True:
            raise RuntimeError('Update Termux:Aether API for Virtio-FS storage configuration')
        if current.get('running') is not False or current.get('active_sessions') != 0:
            raise RuntimeError('Exit Arch sessions and run termux-arch-vm --stop before changing sharing')
        path = args.share_enable or ''
        if path:
            folder = Path(path)
            if str(folder.resolve()) != path:
                raise RuntimeError('Shared folder cannot contain symlink components')
            folder.mkdir(parents=True, exist_ok=True)
        result = arch.api('share-configure', shared_path=path)
        if result.get('shared_storage_supported') is not True:
            raise RuntimeError(result.get('reason') or 'Storage configuration is unsupported')
    elif args.memory_live is not None:
        result = arch.api('memory-live', memory=args.memory_live)
    else:
        config = arch.load_config()
        memory = None if config['memory'] is None else arch.memory_mib(str(config['memory']))
        result = arch.api('disk-grow', disk_bytes=args.grow_disk * 1024 * 1024)
        if result.get('status') == 'error' or result.get('filesystem_growth_required') is not True:
            raise RuntimeError(result.get('reason') or json.dumps(result))
        # AVF must reopen the expanded block image before guest ext4 can grow.
        # An interrupted resize leaves the sparse capacity available for retry.
        directory = Path.home() / '.config/termux/arch-vm'
        identity, key = arch.credentials(directory)
        with arch.ready_vm(directory, key, memory=memory,
                           graphics_mode=config['graphics_mode']) as state:
            known = arch.pin_host(directory, state['ssh_host_key'])
            invocation = arch.ssh_command(identity, known, state['ssh_port'], '/', ['resize2fs', '/dev/vda'], False)
            process = subprocess.run(invocation, stdout=sys.stderr, stderr=sys.stderr, timeout=120)
            if process.returncode:
                raise RuntimeError('Disk capacity extended, but ext4 growth failed; retry the same --grow-disk size')
        result = arch.api('status')
        result['filesystem_growth_completed'] = True
    print(json.dumps(result, indent=2))
    if result.get('status') in ('error', 'unavailable', 'unsupported', 'denied'):
        return 1
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'termux-arch-resources: {error}', file=sys.stderr)
        sys.exit(1)
